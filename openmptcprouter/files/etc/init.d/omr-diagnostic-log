#!/bin/sh /etc/rc.common

START=13
STOP=88

USE_PROCD=1

LOG_DIR="/etc/openmptcprouter-logs"
LOG_FILE="${LOG_DIR}/diagnostic.log"
LOG_SIZE=1024
LOG_PATTERN="OMR\\|omr-\\|openmptcprouter\\|mqvpn\\|xquic\\|glorytun\\|MPTCP\\|mptcp\\|nanbbr\\|netifd\\|firewall"

start_service() {
	mkdir -p "$LOG_DIR"
	chmod 700 "$LOG_DIR"

	procd_open_instance
	procd_set_param command /sbin/logread -f -e "$LOG_PATTERN" \
		-F "$LOG_FILE" -S "$LOG_SIZE" -p /var/run/omr-diagnostic-log.pid
	procd_set_param respawn 5 1 -1
	procd_close_instance
}
