#!/bin/sh
set -eu

STORE="/usr/lib/gtun-swap"
ORIG_BIN="${STORE}/glorytun.original"
OMRDEV5_BIN="${STORE}/glorytun.omrdev5"

usage() {
	echo "Usage: gtun-swap {status|orig|omrdev5|import <path>}" >&2
	exit 1
}

target_bin() {
	if [ -x /usr/sbin/glorytun ]; then
		echo /usr/sbin/glorytun
	elif [ -x /usr/bin/glorytun ]; then
		echo /usr/bin/glorytun
	else
		echo /usr/sbin/glorytun
	fi
}

sha_or_na() {
	file="$1"
	if [ -f "$file" ]; then
		if command -v sha256sum >/dev/null 2>&1; then
			sha256sum "$file" | awk '{print $1}'
		else
			echo unavailable
		fi
	else
		echo missing
	fi
}

ensure_store() {
	target="$(target_bin)"
	mkdir -p "${STORE}"
	if [ -x "$target" ] && [ ! -f "${ORIG_BIN}" ]; then
		cp -fp "$target" "${ORIG_BIN}"
		chmod 755 "${ORIG_BIN}"
	fi
}

restart_glorytun() {
	/etc/init.d/glorytun restart >/dev/null 2>&1 || true
}

apply_bin() {
	src="$1"
	label="$2"
	target="$(target_bin)"

	if [ ! -f "$src" ]; then
		echo "Missing binary: $src" >&2
		echo "Tip: run gtun-swap import /tmp/glorytun-2.0.0-omrdev5-openwrt-x86_64-musl" >&2
		exit 2
	fi

	install -m 0755 "$src" "$target"
	restart_glorytun
	echo "active=${label} target=${target} sha=$(sha_or_na "$target")"
}

show_status() {
	target="$(target_bin)"
	target_sha="$(sha_or_na "$target")"
	orig_sha="$(sha_or_na "${ORIG_BIN}")"
	omr_sha="$(sha_or_na "${OMRDEV5_BIN}")"
	profile="custom"

	if [ "$target_sha" = "$orig_sha" ] && [ "$target_sha" != "missing" ]; then
		profile="orig"
	elif [ "$target_sha" = "$omr_sha" ] && [ "$target_sha" != "missing" ]; then
		profile="omrdev5"
	fi

	echo "target=${target}"
	echo "profile=${profile}"
	echo "target_sha=${target_sha}"
	echo "orig_sha=${orig_sha}"
	echo "omrdev5_sha=${omr_sha}"
	pgrep -fa 'glorytun .*dev tun' 2>/dev/null || true
}

import_omrdev5() {
	src="${1:-}"
	if [ -z "$src" ]; then
		usage
	fi
	if [ ! -f "$src" ]; then
		echo "File not found: $src" >&2
		exit 2
	fi
	install -m 0755 "$src" "${OMRDEV5_BIN}"
	echo "imported=${OMRDEV5_BIN} sha=$(sha_or_na "${OMRDEV5_BIN}")"
}

ensure_store

cmd="${1:-status}"
case "$cmd" in
	status)
		show_status
		;;
	orig|original)
		apply_bin "${ORIG_BIN}" "orig"
		;;
	omrdev5|omr)
		apply_bin "${OMRDEV5_BIN}" "omrdev5"
		;;
	import)
		shift
		import_omrdev5 "${1:-}"
		;;
	*)
		usage
		;;
esac
