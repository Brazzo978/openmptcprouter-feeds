diff --git a/src/platform/linux/netlink_mon.c b/src/platform/linux/netlink_mon.c
--- a/src/platform/linux/netlink_mon.c
+++ b/src/platform/linux/netlink_mon.c
@@ -650,7 +650,11 @@
     schedule_next_tick(p);
 
 rearm:
-    if (p->ev_recover) {
+    /* mqvpn_client_tick() above can synchronously transition to CLOSED or
+     * initiate shutdown while this callback is running. Do not undo its
+     * event_del by rearming after that transition. */
+    if (p->ev_recover && !p->shutting_down &&
+        mqvpn_client_get_state(p->client) != MQVPN_STATE_CLOSED) {
         struct timeval tv = {.tv_sec = RECOVER_INTERVAL_SEC};
         event_add(p->ev_recover, &tv);
     }
