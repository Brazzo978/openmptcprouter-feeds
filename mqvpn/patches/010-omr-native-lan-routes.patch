+int
+mqvpn_config_add_client_route(mqvpn_config_t *cfg, const char *cidr)
+{
+    if (!cfg || !cidr || cfg->n_client_routes >= MQVPN_CLIENT_ROUTE_PER_USER)
+        return MQVPN_ERR_INVALID_ARG;
+    mqvpn_client_route_t route;
+    if (mqvpn_client_route_parse(cidr, &route) < 0)
+        return MQVPN_ERR_INVALID_ARG;
+    for (int i = 0; i < cfg->n_client_routes; i++) {
+        mqvpn_client_route_t old;
+        if (mqvpn_client_route_parse(cfg->client_routes[i], &old) == 0 &&
+            mqvpn_client_route_overlaps(&route, &old))
+            return MQVPN_ERR_INVALID_ARG;
+    }
+    snprintf(cfg->client_routes[cfg->n_client_routes++], 32, "%s", cidr);
     return MQVPN_OK;
 }
 
