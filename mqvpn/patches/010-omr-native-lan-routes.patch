+
+/* Replace a named user's LAN route grants atomically. Only the event-loop
+ * thread calls this and the packet callbacks, so the table needs no lock. */
+int
+mqvpn_server_replace_client_routes(mqvpn_server_t *s, const char *user,
+                                   const char *const *cidrs, int n)
+{
+    if (!s || !user || !user[0] || strlen(user) >= 64 ||
+        n < 0 || n > MQVPN_CLIENT_ROUTE_PER_USER || (n && !cidrs))
+        return MQVPN_ERR_INVALID_ARG;
+    int known = 0;
+    for (int i = 0; i < s->config.n_users; i++)
+        if (strcmp(s->config.user_names[i], user) == 0) known = 1;
+    if (!known) return MQVPN_ERR_INVALID_ARG;
+
+    mqvpn_client_route_t staged[MQVPN_CLIENT_ROUTE_PER_USER];
+    mqvpn_client_route_t pool_route = {0};
+    pool_route.net = ntohl(s->pool.base.s_addr);
+    pool_route.prefix = (uint8_t)s->pool.prefix_len;
+    pool_route.mask = UINT32_MAX << (32 - pool_route.prefix);
+    for (int i = 0; i < n; i++) {
+        if (mqvpn_client_route_parse(cidrs[i], &staged[i]) < 0 ||
+            mqvpn_client_route_overlaps(&staged[i], &pool_route))
+            return MQVPN_ERR_INVALID_ARG;
+        snprintf(staged[i].user, sizeof(staged[i].user), "%s", user);
+        for (int j = 0; j < i; j++)
+            if (mqvpn_client_route_overlaps(&staged[i], &staged[j]))
+                return MQVPN_ERR_INVALID_ARG;
+        for (int j = 0; j < s->n_client_routes; j++)
+            if (strcmp(s->client_routes[j].user, user) != 0 &&
+                mqvpn_client_route_overlaps(&staged[i], &s->client_routes[j]))
+                return MQVPN_ERR_INVALID_ARG;
+    }
+    int kept = 0;
+    for (int i = 0; i < s->n_client_routes; i++)
+        if (strcmp(s->client_routes[i].user, user) != 0) kept++;
+    if (kept + n > MQVPN_CLIENT_ROUTE_MAX) return MQVPN_ERR_MAX_CLIENTS;
+    kept = 0;
+    for (int i = 0; i < s->n_client_routes; i++)
+        if (strcmp(s->client_routes[i].user, user) != 0)
+            s->client_routes[kept++] = s->client_routes[i];
+    if (n) memcpy(&s->client_routes[kept], staged, (size_t)n * sizeof(staged[0]));
+    s->n_client_routes = kept + n;
+    return MQVPN_OK;
+}
+
+int
+mqvpn_server_get_client_routes(const mqvpn_server_t *s, const char *user,
+                               char routes[][32], int max, int *session_count)
+{
+    if (!s || !user || !user[0] || !session_count || max < 0 ||
+        (max && !routes)) return MQVPN_ERR_INVALID_ARG;
+    int known = 0;
+    for (int i = 0; i < s->config.n_users; i++)
+        if (strcmp(s->config.user_names[i], user) == 0) known = 1;
+    if (!known) return MQVPN_ERR_INVALID_ARG;
+    *session_count = 0;
+    for (int i = 1; i <= MQVPN_ADDR_POOL_MAX; i++) {
+        svr_conn_t *conn = s->sessions[i];
+        if (conn && conn->tunnel_established && strcmp(conn->username, user) == 0)
+            (*session_count)++;
+    }
+    int count = 0;
+    for (int i = 0; i < s->n_client_routes; i++) {
+        const mqvpn_client_route_t *r = &s->client_routes[i];
+        if (strcmp(r->user, user) != 0) continue;
+        if (count >= max) return MQVPN_ERR_INVALID_ARG;
+        struct in_addr addr = { .s_addr = htonl(r->net) };
+        char ip[INET_ADDRSTRLEN];
+        if (!inet_ntop(AF_INET, &addr, ip, sizeof(ip)))
+            return MQVPN_ERR_INVALID_ARG;
+        snprintf(routes[count++], 32, "%s/%u", ip, r->prefix);
+    }
+    return count;
+}
