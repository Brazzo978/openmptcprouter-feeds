diff --git a/tests/test_client_routes.c b/tests/test_client_routes.c
new file mode 100644
--- /dev/null
+++ b/tests/test_client_routes.c
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: Apache-2.0
+#include "client_routes.h"
+#include <stdlib.h>
+#define CHECK(x) do { if (!(x)) abort(); } while (0)
+#include <stdio.h>
+
+static uint32_t ip(const char *text)
+{
+    struct in_addr addr;
+    CHECK(inet_pton(AF_INET, text, &addr) == 1);
+    return ntohl(addr.s_addr);
+}
+int main(void)
+{
+    mqvpn_client_route_t a = {0}, b = {0};
+    CHECK(mqvpn_client_route_parse("192.168.2.8/24", &a) == 0);
+    CHECK(a.net == ip("192.168.2.0"));
+    CHECK(mqvpn_client_route_contains(&a, ip("192.168.2.99")));
+    CHECK(!mqvpn_client_route_contains(&a, ip("192.168.3.1")));
+    CHECK(mqvpn_client_route_parse("192.168.2.64/26", &b) == 0);
+    CHECK(mqvpn_client_route_overlaps(&a, &b));
+    mqvpn_client_route_t routes[2] = {a, b};
+    CHECK(mqvpn_client_route_lookup(routes, 2, ip("192.168.2.70")) == &routes[1]);
+    CHECK(mqvpn_client_route_lookup(routes, 2, ip("192.168.2.10")) == &routes[0]);
+    CHECK(mqvpn_client_route_lookup(routes, 2, ip("192.168.3.1")) == NULL);
+    const char *bad[] = {
+        "0.0.0.0/0", "10.0.0.0/8", "10.255.0.0/16", "10.255.247.0/24",
+        "172.0.0.0/8", "192.168.0.0/15", "8.8.8.0/24",
+        "192.168.2.0/33", "192.168.2.0/x", "192.168.2.0",
+        "192.168.2.0/24junk"
+    };
+    for (size_t i = 0; i < sizeof(bad)/sizeof(bad[0]); i++)
+        CHECK(mqvpn_client_route_parse(bad[i], &a) < 0);
+    CHECK(mqvpn_client_route_parse("10.42.0.0/16", &a) == 0);
+    CHECK(mqvpn_client_route_parse("172.16.0.0/12", &a) == 0);
+    puts("client routes OK");
+    return 0;
+}
