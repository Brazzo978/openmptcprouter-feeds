 static int
+ctrl_cmd_replace_client_routes(const char *req, char *resp, size_t cap,
+                               ctrl_socket_t *cs)
+{
+    if (!cs->server)
+        return snprintf(resp, cap, "{\"ok\":false,\"error\":\"server only\"}");
+    char user[64] = {0};
+    const char *uv = json_find_key(req, "user");
+    const char *v = json_find_key(req, "routes");
+    if (!uv || json_read_string(uv, user, sizeof(user)) < 0 || !user[0] ||
+        !v || *v != '[')
+        return snprintf(resp, cap, "{\"ok\":false,\"error\":\"user and routes required\"}");
+    char routes[16][32] = {{0}};
+    const char *ptrs[16];
+    int n = 0;
+    v = json_skip_ws(v + 1);
+    while (*v != ']') {
+        if (*v != '"' || n == 16)
+            return snprintf(resp, cap, "{\"ok\":false,\"error\":\"invalid routes\"}");
+        const char *end = strchr(v + 1, '"');
+        if (!end || (size_t)(end - v - 1) >= sizeof(routes[0]) ||
+            memchr(v + 1, '\\', (size_t)(end - v - 1)))
+            return snprintf(resp, cap, "{\"ok\":false,\"error\":\"invalid route\"}");
+        memcpy(routes[n], v + 1, (size_t)(end - v - 1));
+        ptrs[n] = routes[n];
+        n++;
+        v = json_skip_ws(end + 1);
+        if (*v == ',') {
+            v = json_skip_ws(v + 1);
+            if (*v == ']')
+                return snprintf(resp, cap, "{\"ok\":false,\"error\":\"invalid routes\"}");
+        } else if (*v != ']') {
+            return snprintf(resp, cap, "{\"ok\":false,\"error\":\"invalid routes\"}");
+        }
+    }
+    int rc = mqvpn_server_replace_client_routes(cs->server, user, ptrs, n);
+    if (rc != MQVPN_OK)
+        return snprintf(resp, cap, "{\"ok\":false,\"error\":\"route grant rejected (%d)\"}", rc);
+    return snprintf(resp, cap, "{\"ok\":true,\"n_routes\":%d}", n);
+}
+
+static int
+ctrl_cmd_get_client_routes(const char *req, char *resp, size_t cap,
+                           ctrl_socket_t *cs)
+{
+    if (!cs->server)
+        return snprintf(resp, cap, "{\"ok\":false,\"error\":\"server only\"}");
+    char user[64] = {0}, routes[16][32] = {{0}};
+    const char *uv = json_find_key(req, "user");
+    if (!uv || json_read_string(uv, user, sizeof(user)) < 0 || !user[0])
+        return snprintf(resp, cap, "{\"ok\":false,\"error\":\"user required\"}");
+    int session_count = 0;
+    int n = mqvpn_server_get_client_routes(cs->server, user, routes, 16,
+                                           &session_count);
+    if (n < 0)
+        return snprintf(resp, cap, "{\"ok\":false,\"error\":\"unknown user\"}");
+    int pos = snprintf(resp, cap, "{\"ok\":true,\"user\":\"%s\",\"routes\":[", user);
+    for (int i = 0; i < n && pos > 0 && (size_t)pos < cap; i++)
+        pos += snprintf(resp + pos, cap - (size_t)pos, "%s\"%s\"",
+                        i ? "," : "", routes[i]);
+    if (pos <= 0 || (size_t)pos >= cap) return 0;
+    return pos + snprintf(resp + pos, cap - (size_t)pos,
+                          "],\"session_count\":%d}", session_count);
+}
