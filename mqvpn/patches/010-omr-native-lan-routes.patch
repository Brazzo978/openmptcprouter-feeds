diff --git a/src/client_routes.h b/src/client_routes.h
new file mode 100644
--- /dev/null
+++ b/src/client_routes.h
@@ -0,0 +1,75 @@
+// SPDX-License-Identifier: Apache-2.0
+#ifndef MQVPN_CLIENT_ROUTES_H
+#define MQVPN_CLIENT_ROUTES_H
+#include <stdint.h>
+#include <string.h>
+#ifdef _WIN32
+# include <winsock2.h>
+# include <ws2tcpip.h>
+#else
+# include <arpa/inet.h>
+#endif
+#define MQVPN_CLIENT_ROUTE_MAX 1024 /* 64 named users x 16 routes */
+#define MQVPN_CLIENT_ROUTE_PER_USER 16
+typedef struct {
+    char user[64];
+    uint32_t net; /* host byte order */
+    uint32_t mask;
+    uint8_t prefix;
+} mqvpn_client_route_t;
+static inline int
+mqvpn_client_route_parse(const char *cidr, mqvpn_client_route_t *out)
+{
+    if (!cidr || !out || strlen(cidr) >= 32) return -1;
+    char ip[32];
+    const char *slash = strchr(cidr, '/');
+    if (!slash || slash == cidr || slash[1] == '\0' ||
+        (size_t)(slash - cidr) >= sizeof(ip)) return -1;
+    memcpy(ip, cidr, (size_t)(slash - cidr));
+    ip[slash - cidr] = '\0';
+    unsigned prefix = 0;
+    for (const char *p = slash + 1; *p; p++) {
+        if (*p < '0' || *p > '9') return -1;
+        prefix = prefix * 10 + (unsigned)(*p - '0');
+        if (prefix > 32) return -1;
+    }
+    struct in_addr addr;
+    if (inet_pton(AF_INET, ip, &addr) != 1) return -1;
+    uint32_t mask = prefix ? UINT32_MAX << (32 - prefix) : 0;
+    uint32_t net = ntohl(addr.s_addr) & mask;
+    /* LANs must fit one RFC1918 block. OMR reserves 10.255/16 for tunnels. */
+    int priv = (prefix >= 8 && (net & 0xff000000U) == 0x0a000000U) ||
+               (prefix >= 12 && (net & 0xfff00000U) == 0xac100000U) ||
+               (prefix >= 16 && (net & 0xffff0000U) == 0xc0a80000U);
+    if (!priv) return -1;
+    uint32_t reserved = 0x0aff0000U;
+    uint32_t common = prefix < 16 ? mask : 0xffff0000U;
+    if ((net & common) == (reserved & common)) return -1;
+    out->net = net;
+    out->mask = mask;
+    out->prefix = (uint8_t)prefix;
+    return 0;
+}
+static inline int
+mqvpn_client_route_contains(const mqvpn_client_route_t *r, uint32_t addr)
+{
+    return (addr & r->mask) == r->net;
+}
+static inline int
+mqvpn_client_route_overlaps(const mqvpn_client_route_t *a,
+                            const mqvpn_client_route_t *b)
+{
+    uint32_t common = a->prefix < b->prefix ? a->mask : b->mask;
+    return (a->net & common) == (b->net & common);
+}
+static inline const mqvpn_client_route_t *
+mqvpn_client_route_lookup(const mqvpn_client_route_t *routes, int n, uint32_t addr)
+{
+    const mqvpn_client_route_t *best = NULL;
+    for (int i = 0; i < n; i++) {
+        if (mqvpn_client_route_contains(&routes[i], addr) &&
+            (!best || routes[i].prefix > best->prefix)) best = &routes[i];
+    }
+    return best;
+}
+#endif
