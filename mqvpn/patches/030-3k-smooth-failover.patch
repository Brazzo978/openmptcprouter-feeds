+/* A path can be created in xquic before its challenge completes. Preserve
+ * the connection only if a different path was actually validated and remains
+ * attached; xquic_path_live by itself does not imply validation or reachability.
+ * The most recent validation is not a guarantee that it is reachable now. */
+static int
+client_has_validated_alternate(const mqvpn_client_t *c, const path_entry_t *failed)
+{
+    for (int i = 0; i < c->n_paths; i++) {
+        const path_entry_t *other = &c->paths[i];
+        if (other != failed && other->state == PATH_LC_ACTIVE &&
+            other->platform_attached && other->fd >= 0 && other->xquic_path_live)
+            return 1;
+    }
+    return 0;
+}
