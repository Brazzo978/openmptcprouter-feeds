+#!/usr/bin/env python3
+"""Exercise an actual MQVPN tunnel entirely inside disposable Linux netns.
+
+The two WANs are veth pairs, not host interfaces. The test sends an ordered TCP
+echo stream inside MQVPN and periodically checks the client's TUN ifindex. Run
+as root with the built mqvpn binary, iproute2, ping, openssl and Python 3.
+
+Example: sudo python3 run_3k_smooth_failover.py /path/to/mqvpn --event remove
+"""
+import argparse
+import datetime
+import hashlib
+import json
+import os
+import re
+import secrets
+import signal
+import subprocess
+import sys
+import tempfile
+import time
+from pathlib import Path
+
+parser = argparse.ArgumentParser()
+parser.add_argument('binary', type=lambda x: str(Path(x).resolve()))
+parser.add_argument('--server-binary', type=lambda x: str(Path(x).resolve()),
+                    help='different server binary for compatibility testing')
+parser.add_argument('--event', choices=('remove', 'link', 'blackhole'), default='remove')
+parser.add_argument('--failed-path', choices=('initial', 'secondary'), default='initial')
+parser.add_argument('--readd', action='store_true', help='restore failed path, then remove the survivor')
+parser.add_argument('--no-alternate', action='store_true', help='blackhole the secondary before handshake; expect reconnect')
+parser.add_argument('--wan-latency', action='store_true', help='add unequal latency and 0.2%% loss on both WANs')
+parser.add_argument('--backup', action='store_true', help='configure the second WAN as BackupPath under minrtt')
+parser.add_argument('--fec', action='store_true', help='enable XOR FEC on client and server')
+parser.add_argument('--all-down', action='store_true', help='blackhole both WANs after validation, then restore one')
+parser.add_argument('--observe-seconds', type=int, default=8, help='observation interval for preserved session')
+parser.add_argument('--survivor-drop-seconds', type=float, default=0,
+                    help='briefly blackhole the validated survivor through the first probe')
+parser.add_argument('--keep-logs', action='store_true')
+parser.add_argument('--report', type=Path, help='write a sanitized JSON result')
+args = parser.parse_args()
+
+result = {'status':'FAIL', 'event':args.event, 'failed_path':args.failed_path,
+          'readd':args.readd, 'backup':args.backup, 'no_alternate':args.no_alternate,
+          'wan_latency':args.wan_latency, 'fec_requested':args.fec,
+          'all_down':args.all_down, 'observe_seconds':args.observe_seconds,
+          'survivor_drop_seconds':args.survivor_drop_seconds,
+          'started_utc':datetime.datetime.now(datetime.timezone.utc).isoformat(),
+          'binary_sha256':hashlib.sha256(Path(args.binary).read_bytes()).hexdigest(),
+          'server_binary_sha256':hashlib.sha256(Path(args.server_binary or args.binary).read_bytes()).hexdigest(),
+          'scope':'isolated Linux netns, real MQVPN client/server and xquic; synthetic TCP/UDP',
+          'failure':None}
+
+tag = secrets.token_hex(3)
+ns_c, ns_s = 'omrc' + tag, 'omrs' + tag
+a0, a1, b0, b1 = ('c' + tag + 'a', 's' + tag + 'a', 'c' + tag + 'b', 's' + tag + 'b')
+created_ns, created_links, children = [], [], []
+directory = tempfile.TemporaryDirectory(prefix='omr3k-failover-')
+work = Path(directory.name)
+
+def run(*cmd, check=True, timeout=15, env=None):
+    return subprocess.run(cmd, check=check, timeout=timeout, text=True,
+                          stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
+
+def ip(*cmd, **kwargs):
+    return run('ip', *cmd, **kwargs)
+
+def inside(ns, *cmd, **kwargs):
+    return ip('netns', 'exec', ns, *cmd, **kwargs)
+
+def start(ns, name, *cmd):
+    log = (work / (name + '.log')).open('w')
+    proc = subprocess.Popen(['ip', 'netns', 'exec', ns, *cmd], stdout=log,
+                            stderr=subprocess.STDOUT, start_new_session=True)
+    children.append((proc, log))
+    return proc
+
+def tun_index():
+    out = inside(ns_c, 'ip', '-j', 'link', 'show', 'mqvpn0', check=False)
+    try: return json.loads(out.stdout)[0]['ifindex']
+    except (ValueError, IndexError, KeyError): return None
+
+def control(command):
+    script = ('import socket,sys; s=socket.create_connection(("127.0.0.1",9091),2); '
+              's.sendall((sys.argv[1]+"\\n").encode()); data=b""; '
+              'exec("while True:\\n b=s.recv(65536)\\n if not b: break\\n data+=b"); '
+              'sys.stdout.write(data.decode())')
+    p = inside(ns_c, sys.executable, '-c', script, json.dumps(command), check=False, timeout=5)
+    if p.returncode: return None
+    try: return json.loads(p.stdout)
+    except ValueError: return None
+
+def wait_for(predicate, seconds, label):
+    until = time.monotonic() + seconds
+    while time.monotonic() < until:
+        val = predicate()
+        if val: return val
+        time.sleep(.2)
+    raise RuntimeError('timeout waiting for ' + label)
+
+def setup_pair(left, right, cidr_c, cidr_s):
+    ip('link', 'add', left, 'type', 'veth', 'peer', 'name', right)
+    created_links.extend((left, right))
+    ip('link', 'set', left, 'netns', ns_c)
+    ip('link', 'set', right, 'netns', ns_s)
+    inside(ns_c, 'ip', 'addr', 'add', cidr_c, 'dev', left)
+    inside(ns_s, 'ip', 'addr', 'add', cidr_s, 'dev', right)
+    inside(ns_c, 'ip', 'link', 'set', left, 'up')
+    inside(ns_s, 'ip', 'link', 'set', right, 'up')
+
+echo_server = '''import socket
