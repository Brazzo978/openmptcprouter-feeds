+int
+mqvpn_rotate_reconnect_path(int cur_idx, const uint32_t *path_flags,
+                            const int *usable, int n_paths)
+{
+    if (n_paths <= 0 || !path_flags || !usable) return -1;
+    if (cur_idx < 0 || cur_idx >= n_paths) cur_idx = n_paths - 1;
+    for (int backup = 0; backup <= 1; backup++) {
+        for (int step = 1; step <= n_paths; step++) {
+            int i = (cur_idx + step) % n_paths;
+            if (!usable[i]) continue;
+            int is_backup = (path_flags[i] & MQVPN_PATH_FLAG_BACKUP) != 0;
+            if (is_backup == backup) return i;
+        }
+    }
+    return -1;
+}
