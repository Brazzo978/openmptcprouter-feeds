+/* Shared by the control API and platform/netlink paths. On the initial path,
+ * preserve the original recovery fallback unless an alternate was validated.
+ * xqc_conn_close_path sends PATH_ABANDON on the survivor and returns queued
+ * packets for rescheduling. An immediate PING wakes both peers promptly;
+ * failure to queue it is logged but should not destroy an otherwise usable
+ * connection. If xquic cannot retire the path, force the existing reconnect. */
+static void
+client_retire_failed_path(mqvpn_client_t *c, path_entry_t *p)
+{
+    if (!path_xquic_abandon_due(p) || !c->engine || !c->conn) return;
+    if (p->xqc_path_id == 0 && !client_has_validated_alternate(c, p)) {
+        LOG_I(c, "initial path removed with no validated alternate; reconnecting");
+        xqc_h3_conn_close(c->engine, &c->conn->cid);
+        return;
+    }
+
+    xqc_int_t rc = xqc_conn_close_path(c->engine, &c->conn->cid, p->xqc_path_id);
+    if (rc != XQC_OK) {
+        LOG_W(c, "xqc_conn_close_path(path_id=%" PRIu64 ") rc=%d; "
+              "closing connection for recovery", p->xqc_path_id, (int)rc);
+        if (c->engine && c->conn) xqc_h3_conn_close(c->engine, &c->conn->cid);
+        return;
+    }
+    if (p->xqc_path_id == 0 && c->engine && c->conn) {
+        LOG_I(c, "initial path retired; probing validated alternate");
+        uint64_t now = client_now_us(c);
+        if (++c->failover_probe_generation == 0) ++c->failover_probe_generation;
+        c->failover_probe_deadline_us = now + 12000000ULL;
+        c->failover_probe_next_us = now + 2000000ULL;
+        rc = xqc_h3_conn_send_ping(c->engine, &c->conn->cid,
+                                   (void *)c->failover_probe_generation);
+        if (rc != XQC_OK)
+            LOG_W(c, "failed to queue failover PING: rc=%d", (int)rc);
+    }
+}
