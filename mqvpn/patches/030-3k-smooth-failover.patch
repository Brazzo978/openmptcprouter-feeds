+'''
+udp_server = '''import socket
+s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM);s.bind(("10.0.0.1",18081))
+while True:
+ d,a=s.recvfrom(2048);s.sendto(d,a)
+'''
+udp_client = '''import socket,time
+s=socket.socket(socket.AF_INET,socket.SOCK_DGRAM);s.settimeout(.8)
+for i in range(200):
+ m=str(i).encode();s.sendto(m,("10.0.0.1",18081))
